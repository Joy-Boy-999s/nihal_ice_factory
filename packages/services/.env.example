# ──────────────────────────────────────────────────────────────────
# packages/services/.env.example
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is in .gitignore.
# ──────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=3000

# ── Database (MySQL / Aiven) ──────────────────────────────────────
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# ── Email (SMTP / Gmail App Password) ────────────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ── Auth ──────────────────────────────────────────────────────────
# Generate a strong random secret, e.g.: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_secret_string

# Generate a 64-char hex key, e.g.: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_a_64_char_hex_string

# ── Razorpay Payment Gateway ──────────────────────────────────────
# Sign up free at https://razorpay.com — use test keys for development.
# Test key IDs start with rzp_test_  |  Live key IDs start with rzp_live_
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
