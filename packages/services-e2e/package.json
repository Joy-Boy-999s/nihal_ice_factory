{
  "name": "@nihal-ice-factory/services-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@nihal-ice-factory/services"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "packages/services-e2e/jest.config.ts",
          "passWithNoTests": true
        },
        "dependsOn": [
          "@nihal-ice-factory/services:build"
        ]
      }
    }
  }
}
