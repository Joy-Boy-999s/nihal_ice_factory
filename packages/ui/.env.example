# ──────────────────────────────────────────────────────────────────
# packages/ui/.env.example
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is in .gitignore.
# ──────────────────────────────────────────────────────────────────

# ── Backend API URL ───────────────────────────────────────────────
# Local dev:      http://localhost:3000
# Render (prod):  https://your-app.onrender.com
VITE_API_URL=http://localhost:3000

# ── Invoice / GST details (optional) ──────────────────────────────
# When VITE_COMPANY_GSTIN is set, invoices render as GST tax invoices
# with HSN codes and an inclusive CGST/SGST breakup.
VITE_COMPANY_GSTIN=
VITE_COMPANY_ADDRESS=
VITE_ICE_HSN_CODE=2201
VITE_GST_RATE=5
